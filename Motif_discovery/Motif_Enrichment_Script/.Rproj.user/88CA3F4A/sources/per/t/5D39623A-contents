##
## Columns:
## 5mer
## mean_IRIS_score
## n_sequences
##
###############################################################


###############################################################
## USER SETTINGS
###############################################################

setwd(
"/Users/eduardo/EC_Documents/Lin_lab/IRIS_Project/IRIS_Model/NAR_IRIS_model/Motif_enrichment/R_code/RBP_complex/1URN/FULL_RNA"
)


input_file <- "kmer_IRIS.csv"

output_file <- "IRIS_5mer_average.csv"



###############################################################
## Load libraries
###############################################################

library(dplyr)



###############################################################
## Read input file
###############################################################

data <- read.csv(
    input_file,
    header = FALSE,
    stringsAsFactors = FALSE
)


colnames(data) <- c(
    "sequence",
    "score"
)


data$score <- as.numeric(
    data$score
)



cat(
"Total sequences:",
nrow(data),
"\n"
)



###############################################################
## Function to extract lowercase RNA region
###############################################################

extract_rna <- function(sequence)
{

    chars <- strsplit(
        sequence,
        ""
    )[[1]]


    rna_positions <- which(
        grepl(
            "[a-z]",
            chars
        )
    )


    if(length(rna_positions)==0)
    {
        return(NA)
    }


    rna <- paste0(
        chars[rna_positions],
        collapse=""
    )


    return(rna)

}



###############################################################
## Extract RNA regions
###############################################################

data$rna <- sapply(
    data$sequence,
    extract_rna
)


data <- data[
    !is.na(data$rna),
]


cat(
"Sequences with RNA:",
nrow(data),
"\n"
)



###############################################################
## Extract all possible 5mers from RNA
###############################################################

extract_5mers <- function(rna)
{

    n <- nchar(rna)


    if(n < 5)
    {
        return(character(0))
    }


    kmers <- character()


    for(i in 1:(n-4))
    {

        kmer <- substr(
            rna,
            i,
            i+4
        )


        kmers <- c(
            kmers,
            kmer
        )

    }


    return(kmers)

}



###############################################################
## Expand sequence into individual 5mers
###############################################################

library <- data.frame(
    kmer=character(),
    score=numeric(),
    stringsAsFactors=FALSE
)



for(i in seq_len(nrow(data)))
{

    kmers <- extract_5mers(
        data$rna[i]
    )


    if(length(kmers)==0)
        next


    temp <- data.frame(
        kmer=kmers,
        score=data$score[i],
        stringsAsFactors=FALSE
    )


    library <- rbind(
        library,
        temp
    )

}



cat(
"Total extracted 5mers:",
nrow(library),
"\n"
)



###############################################################
## Average IRIS score per unique 5mer
###############################################################

summary <- library %>%
    
    group_by(kmer) %>%
    
    summarise(
        mean_IRIS_score = mean(score),
        n_sequences = n(),
        .groups="drop"
    )



colnames(summary)[1] <- "5mer"



###############################################################
## Sort by IRIS score
##
## More negative = stronger predicted binding
###############################################################

summary <- summary %>%
    
    arrange(
        mean_IRIS_score
    )



###############################################################
## Write output
###############################################################

write.csv(
    summary,
    output_file,
    row.names=FALSE
)



###############################################################
## Final report
###############################################################

cat(
"\nFinished\n"
)

cat(
"Unique 5mers:",
nrow(summary),
"\n"
)

cat(
"Output:",
output_file,
"\n"
)
```


##Masked 5mer using Stepwise dG IRIS
```{r}
###############################################################
## IRIS Stepwise 5mer Motif Discovery
##
## Analogous to Dominguez et al. RBNS stepwise R-1 procedure
##
## Concept:
##
## Instead of experimental enrichment (R-1), use IRIS predicted
## binding scores.
##
## Iterative procedure:
##
## 1. Extract all RNA 5mers
## 2. Calculate mean IRIS score per 5mer
## 3. Select strongest predicted binder
## 4. Mask all occurrences of that 5mer
## 5. Recalculate remaining 5mers
## 6. Repeat until stopping criteria
##
###############################################################


###############################################################
## USER SETTINGS
###############################################################

setwd(
"/Users/eduardo/EC_Documents/Lin_lab/IRIS_Project/IRIS_Model/NAR_IRIS_model/Motif_enrichment/R_code/RBP_complex/1URN/FULL_RNA"
)


input_file <- "kmer_IRIS.csv"


output_prefix <- "IRIS"


###############################################################
## Parameters
###############################################################

# Number of motifs to discover
max_iterations <- 50


# Minimum number of occurrences required
# before accepting a motif
min_occurrences <- 1


# Stop if no remaining 5mers
# satisfy this threshold
#
# More negative = stronger IRIS binding
#
min_IRIS_score <- Inf



###############################################################
## Load libraries
###############################################################

library(dplyr)



###############################################################
## Read input file
###############################################################

data <- read.csv(
    input_file,
    header = FALSE,
    stringsAsFactors = FALSE
)


colnames(data) <- c(
    "sequence",
    "score"
)


data$score <- as.numeric(
    data$score
)



cat(
"\nTotal protein-RNA sequences:",
nrow(data),
"\n"
)



###############################################################
## Extract RNA region
##
## Input example:
##
## ProteinAAAAAaaaauuu
##
## Output:
##
## aaaauuu
##
###############################################################

extract_rna <- function(sequence)
{

    chars <- strsplit(
        sequence,
        ""
    )[[1]]


    rna_positions <- which(
        grepl(
            "[a-z]",
            chars
        )
    )


    if(length(rna_positions)==0)
    {
        return(NA)
    }


    rna <- paste0(
        chars[rna_positions],
        collapse=""
    )


    toupper(
        chartr(
            "T",
            "U",
            rna
        )
    )

}



###############################################################
## Extract RNA sequences
###############################################################

data$rna <- sapply(
    data$sequence,
    extract_rna
)


data <- data %>%
    filter(
        !is.na(rna)
    )



cat(
"Sequences containing RNA:",
nrow(data),
"\n"
)



###############################################################
## Initialize masking structure
##
## Each RNA sequence receives a logical vector
##
## FALSE = available nucleotide
## TRUE  = masked nucleotide
##
###############################################################

masked_positions <- list()



for(i in seq_len(nrow(data)))
{

    masked_positions[[i]] <-
