read_pwm <- function(file){


  pwm <- read.csv(
    file,
    header=TRUE,
    stringsAsFactors=FALSE,
    check.names=FALSE
  )


  # Detect nucleotide names

  if(any(
    pwm[,1] %in% c("A","C","G","U")
  )){

