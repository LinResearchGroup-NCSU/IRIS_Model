      dominant_base
    ),


  IRIS_base=
    apply(
      pred_best,
      2,
      dominant_base
    )

)




return(

  list(

    summary=summary,

    position=position,

    RBNS_aligned=ref_best,

    Model_aligned=pred_best

  )

)


}

