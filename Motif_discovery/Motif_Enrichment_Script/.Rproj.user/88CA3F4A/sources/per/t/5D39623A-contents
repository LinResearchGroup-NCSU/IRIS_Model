##Creating Kmer Library by Randomizing entire RNA Sequence
```{r}
###############################################################
## Generate complete 5mer library across ENTIRE RNA sequence
##
## Input:
##
## native.seq
##      Full native sequence
##      Protein = uppercase
##      RNA     = lowercase
##
## Rules:
##
## - ALL lowercase RNA positions are considered
## - randomize_position_RNA.txt is NOT used
## - Protein sequence remains unchanged
## - Every possible RNA 5mer (4^5 = 1024) is generated
## - Every possible 5mer is threaded through every RNA window
## - RNA 5mer substitutions are lowercase
##
###############################################################


###############################################################
## USER SETTINGS
###############################################################

setwd(
"/Users/eduardo/EC_Documents/Lin_lab/IRIS_Project/IRIS_Model/NAR_IRIS_model/Motif_enrichment/R_code/RBP_complex"
)

native_file <- "native.seq"

output_file <- "kmer_library.txt"



###############################################################
## Read native sequence
###############################################################

lines <- readLines(
    native_file
)


# Remove FASTA header if present

lines <- lines[
    !grepl("^>", lines)
]


native_seq <- paste0(
    lines,
    collapse = ""
)


chars <- strsplit(
    native_seq,
    ""
)[[1]]


seq_length <- length(chars)


cat(
    "Native length:",
    seq_length,
    "\n"
)



###############################################################
## Identify ALL RNA positions
##
## RNA is represented by lowercase:
## a, c, g, u
###############################################################

rna_positions <- which(
    chars %in% c(
        "a",
        "c",
        "g",
        "u"
    )
)


if(length(rna_positions) == 0)
{
    stop(
        "No lowercase RNA positions found in native.seq"
    )
}


cat(
    "Total RNA positions:",
    length(rna_positions),
    "\n"
)


cat(
    "RNA range:",
    min(rna_positions),
    "-",
    max(rna_positions),
    "\n"
)


cat(
    "Native RNA:",
    paste0(
        chars[rna_positions],
        collapse = ""
    ),
    "\n"
)



###############################################################
## Check that RNA positions are continuous
###############################################################

if(
    any(
        diff(rna_positions) != 1
    )
)
{
    stop(
        paste(
            "RNA positions are not continuous.",
            "The script expects one continuous RNA region."
        )
    )
}



###############################################################
## Define RNA region
###############################################################

rna_start <- min(
    rna_positions
)

rna_end <- max(
    rna_positions
)

rna_length <- length(
    rna_positions
)


cat(
    "RNA length:",
    rna_length,
    "\n"
)



###############################################################
## Check that RNA is long enough for a 5mer
###############################################################

if(
    rna_length < 5
)
{
    stop(
        "RNA sequence is shorter than 5 nt."
    )
}



###############################################################
## Generate ALL possible RNA 5mers
##
## 4^5 = 1024
###############################################################

bases <- c(
    "a",
    "c",
    "g",
    "u"
)


all_5mers <- apply(
    expand.grid(
        bases,
        bases,
        bases,
        bases,
        bases,
        stringsAsFactors = FALSE
    ),
    1,
    paste0,
    collapse = ""
)


cat(
    "\nTotal possible 5mers:",
    length(all_5mers),
    "\n"
)



###############################################################
## Generate library
##
## Every RNA window receives every possible 5mer.
###############################################################

library <- character()


n_windows <- rna_length - 5 + 1


cat(
    "RNA 5mer windows:",
    n_windows,
    "\n"
)


cat(
    "Expected sequences before duplicate removal:",
    n_windows * length(all_5mers),
    "\n\n"
)



###############################################################
## Thread every possible 5mer
###############################################################

for(i in seq_len(n_windows))
{

    start <- rna_start + i - 1

    end <- start + 4


    cat(
        "Threading RNA positions",
        start,
        "-",
        end,
        "\n"
    )


    for(kmer in all_5mers)
    {

        new_sequence <- chars


        replacement <- strsplit(
            kmer,
            ""
        )[[1]]


        # Replace the current 5mer window

        new_sequence[
            start:end
        ] <- replacement


        library <- c(
            library,
            paste0(
                new_sequence,
                collapse = ""
            )
        )

    }

}



###############################################################
## Remove exact duplicate full sequences
###############################################################

library <- unique(
    library
)



###############################################################
## Write output
###############################################################

writeLines(
    library,
    output_file
)



###############################################################
## Summary
###############################################################

cat(
    "\nFinished\n"
)


cat(
    "Native sequence length:",
    seq_length,
    "\n"
)


cat(
    "RNA length:",
    rna_length,
    "\n"
)


cat(
    "Number of 5mer windows:",
    n_windows,
    "\n"
)


cat(
    "Possible 5mers per window:",
    length(all_5mers),
    "\n"
)


cat(
    "Sequences generated before duplicate removal:",
    n_windows * length(all_5mers),
    "\n"
)


cat(
    "Unique sequences written:",
    length(library),
    "\n"
)


cat(
    "Output file:",
    output_file,
    "\n"
)
```


##Creating Kmer Library within Binding Interface (RNA Contact Map)
```{r}
###############################################################
## Generate complete 5mer threading library
##
## Input:
##5HO41FXL
## native.seq
##      Full native sequence
##      Protein = uppercase
##      RNA = lowercase
##
## randomize_position_RNA.txt
##      Positions where RNA randomization is allowed
##
## Rules:
##
## - Only continuous position blocks are threaded
## - Blocks <5 residues remain native
## - Blocks >=5 residues use sliding 5mer windows
## - Every possible RNA 5mer (4^5 = 1024) is generated
## - Threaded kmers remain lowercase RNA
##
###############################################################


###############################################################
## USER SETTINGS
###############################################################

setwd(
"/Users/eduardo/EC_Documents/Lin_lab/RNA_Protein/IRIS_Model/NAR_IRIS_model/Motif_enrichment/R_code"
)


native_file <- "native.seq"

position_file <- "randomize_position_RNA.txt"

output_file <- "kmer_library.txt"



###############################################################
## Read native sequence
###############################################################

lines <- readLines(native_file)


# Remove FASTA header if present

lines <- lines[
    !grepl("^>", lines)
]


native_seq <- paste0(
    lines,
    collapse=""
)


chars <- strsplit(
    native_seq,
    ""
)[[1]]


seq_length <- length(chars)


cat(
"Native length:",
seq_length,
"\n"
)



###############################################################
## Read randomize positions
###############################################################

positions <- scan(
    position_file,
    what=integer(),
    quiet=TRUE
)


positions <- sort(
    unique(positions)
)


if(length(positions) == 0)
{
    stop(
        "No valid positions found in randomize_position_RNA.txt"
    )
}


cat(
"Randomized positions:",
length(positions),
"\n"
)



###############################################################
## Find continuous position blocks
###############################################################

find_blocks <- function(pos)
{

    blocks <- list()

    start <- pos[1]

    previous <- pos[1]


    counter <- 1


    if(length(pos) == 1)
    {
        blocks[[1]] <- c(
            start,
            previous
        )

        return(blocks)
    }


    for(i in 2:length(pos))
    {

        if(pos[i] == previous + 1)
        {

            previous <- pos[i]

        }
        else
        {

            blocks[[counter]] <- c(
                start,
                previous
            )

            counter <- counter + 1

            start <- pos[i]

            previous <- pos[i]

        }

    }


    blocks[[counter]] <- c(
        start,
        previous
    )


    return(blocks)

}


blocks <- find_blocks(
    positions
)



cat(
"\nContinuous blocks:\n"
)


for(block in blocks)
{

    cat(
        block[1],
        "-",
        block[2],
        "length:",
        block[2]-block[1]+1,
        "\n"
    )

}



###############################################################
## Generate all possible RNA 5mers
###############################################################

# Lowercase RNA alphabet
bases <- c(
    "a",
    "c",
    "g",
    "u"
)


all_5mers <- apply(
    expand.grid(
        bases,
        bases,
        bases,
        bases,
        bases,
        stringsAsFactors=FALSE
    ),
    1,
    paste0,
    collapse=""
)



cat(
"\nTotal 5mers:",
length(all_5mers),
"\n"
)



###############################################################
## Thread 5mers
###############################################################

library <- character()



for(block in blocks)
{


    block_start <- block[1]

    block_end <- block[2]


    block_length <- block_end-block_start+1



    ###########################################################
    ## Ignore short regions
    ###########################################################

    if(block_length < 5)
    {

        cat(
            "Skipping block",
            block_start,
            "-",
            block_end,
            "(length <5)\n"
        )

        next

    }



    ###########################################################
    ## Sliding 5mer windows
    ###########################################################

    for(start in block_start:(block_end-4))
    {


        end <- start + 4


        cat(
            "Threading positions",
            start,
            "-",
            end,
            "\n"
        )



        for(kmer in all_5mers)
        {


            new_sequence <- chars


            replacement <- strsplit(
                kmer,
                ""
            )[[1]]


            # Replace only the 5mer region
            # with lowercase RNA kmer

            new_sequence[start:end] <- replacement



            library <- c(
                library,
                paste0(
                    new_sequence,
                    collapse=""
                )
            )

        }

    }

}



###############################################################
## Remove duplicates
###############################################################

library <- unique(
    library
)



###############################################################
## Write output
###############################################################

writeLines(
    library,
    output_file
)



###############################################################
## Summary
###############################################################

cat(
"\nFinished\n"
)


cat(
"Generated sequences:",
length(library),
"\n"
)


cat(
"Output file:",
output_file,
"\n"
)
```


