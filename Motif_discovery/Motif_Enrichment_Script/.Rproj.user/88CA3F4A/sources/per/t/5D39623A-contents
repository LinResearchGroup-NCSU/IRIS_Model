###############################################################
## RBNS alignment rules (Van Nostrand 2017)
###############################################################

rbns_alignment <- function(seq, ref)
{

    s <- strsplit(seq,"")[[1]]
    r <- strsplit(ref,"")[[1]]

    ###########################################################
    ## Rule 1
    ## +/-1 offset
    ## 0 mismatches among 4 overlaps
    ###########################################################

    for(offset in c(-1,1))
    {

        mismatches <- 0
        overlap <- 0

        for(i in seq_along(s))
        {

            pos <- i + offset

            if(pos >= 1 && pos <= 5)
            {

                overlap <- overlap + 1

                if(s[i] != r[pos])
                    mismatches <- mismatches + 1

            }

        }

        if(overlap == 4 && mismatches == 0)
            return(offset)

    }

    ###########################################################
    ## Rule 2
    ## +/-1 offset
    ## exactly one mismatch
    ###########################################################

    for(offset in c(-1,1))
    {

        mismatches <- 0
        overlap <- 0

        for(i in seq_along(s))
        {

            pos <- i + offset

            if(pos >= 1 && pos <= 5)
            {

                overlap <- overlap + 1

                if(s[i] != r[pos])
                    mismatches <- mismatches + 1

            }

        }

        if(overlap == 4 && mismatches == 1)
            return(offset)

    }

    ###########################################################
    ## Rule 3
    ## no offset
    ## exactly one mismatch
    ###########################################################

    if(sum(s != r) == 1)
        return(0)

    ###########################################################
    ## Rule 4
    ## +/-2 offset
    ## 0 mismatches among 3 overlaps
    ###########################################################

    for(offset in c(-2,2))
    {

        mismatches <- 0
        overlap <- 0

        for(i in seq_along(s))
        {

            pos <- i + offset

            if(pos >= 1 && pos <= 5)
            {

                overlap <- overlap + 1

                if(s[i] != r[pos])
                    mismatches <- mismatches + 1

            }

        }

        if(overlap == 3 && mismatches == 0)
            return(offset)

    }

    return(NA)

}

