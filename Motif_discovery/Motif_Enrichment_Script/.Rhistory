overlap == K - 1 &&
mismatches == 0
)
{
return(offset)
}
}
###########################################################
## Rule 2
##
## +/-1 offset
## exactly 1 mismatch among K-1 overlaps
###########################################################
for(offset in c(-1, 1))
{
mismatches <- 0
overlap <- 0
for(i in seq_along(s))
{
pos <- i + offset
if(pos >= 1 && pos <= K)
{
overlap <- overlap + 1
if(s[i] != r[pos])
mismatches <- mismatches + 1
}
}
if(
overlap == K - 1 &&
mismatches == 1
)
{
return(offset)
}
}
###########################################################
## Rule 3
##
## No offset
## exactly 1 mismatch across entire kmer
###########################################################
if(
sum(s != r) == 1
)
{
return(0)
}
###########################################################
## Rule 4
##
## +/-2 offset
## 0 mismatches among K-2 overlaps
###########################################################
for(offset in c(-2, 2))
{
mismatches <- 0
overlap <- 0
for(i in seq_along(s))
{
pos <- i + offset
if(pos >= 1 && pos <= K)
{
overlap <- overlap + 1
if(s[i] != r[pos])
mismatches <- mismatches + 1
}
}
if(
overlap == K - 2 &&
mismatches == 0
)
{
return(offset)
}
}
###########################################################
## No valid alignment
###########################################################
return(NA)
}
###############################################################
## Strongest binder = highest IRIS weight
##
## Input weight = exp(-z-score)
###############################################################
reference <- kmers$sequence[
which.max(kmers$weight)
]
ref_index <- which.max(kmers$weight)
cat(
"\nReference ",
KMER_LENGTH,
"-mer: ",
reference,
"\n",
sep = ""
)
cat(
"Reference weight: ",
kmers$weight[ref_index],
"\n",
sep = ""
)
###############################################################
## Align all kmers
###############################################################
aligned <- data.frame(
sequence = reference,
weight = kmers$weight[ref_index],
offset = 0,
stringsAsFactors = FALSE
)
rejected <- data.frame(
sequence = character(),
weight = numeric(),
stringsAsFactors = FALSE
)
###############################################################
## Perform alignment
###############################################################
for(i in seq_len(nrow(kmers)))
{
if(kmers$sequence[i] == reference)
next
offset <- rbns_alignment(
kmers$sequence[i],
reference
)
if(is.na(offset))
{
rejected <- rbind(
rejected,
kmers[i,]
)
}
else
{
aligned <- rbind(
aligned,
data.frame(
sequence = kmers$sequence[i],
weight = kmers$weight[i],
offset = offset,
stringsAsFactors = FALSE
)
)
}
}
###############################################################
## Save aligned/rejected kmers
###############################################################
write.csv(
aligned,
paste0(
output_prefix,
"_aligned_6mers.csv"
),
row.names = FALSE
)
write.csv(
rejected,
paste0(
output_prefix,
"_rejected_6mers.csv"
),
row.names = FALSE
)
###############################################################
## Alignment summary
###############################################################
cat(
"\nAligned ",
KMER_LENGTH,
"-mers: ",
nrow(aligned),
"\n",
sep = ""
)
cat(
"Rejected ",
KMER_LENGTH,
"-mers: ",
nrow(rejected),
"\n",
sep = ""
)
cat(
"Alignment rate: ",
round(
100 *
nrow(aligned) /
nrow(kmers),
2
),
"%\n",
sep = ""
)
###############################################################
## Build weighted PWM dynamically
###############################################################
alphabet <- c(
"A",
"C",
"G",
"U"
)
###############################################################
## Determine motif coordinates
###############################################################
aligned_positions <- data.frame(
start = aligned$offset + 1,
end = aligned$offset + KMER_LENGTH
)
motif_start <- min(
aligned_positions$start
)
motif_end <- max(
aligned_positions$end
)
pwm_length <- motif_end -
motif_start +
1
cat(
"\nMotif length: ",
pwm_length,
" positions\n",
sep = ""
)
###############################################################
## Initialize count matrix
###############################################################
counts <- matrix(
0,
nrow = 4,
ncol = pwm_length,
dimnames = list(
alphabet,
NULL
)
)
missing_weight <- rep(
0,
pwm_length
)
###############################################################
## Total aligned weight
###############################################################
total_weight <- sum(
aligned$weight
)
###############################################################
## Add weighted kmers
###############################################################
for(i in seq_len(nrow(aligned)))
{
chars <- strsplit(
aligned$sequence[i],
""
)[[1]]
w <- aligned$weight[i]
offset <- aligned$offset[i]
occupied <- logical(
pwm_length
)
###########################################################
## Add nucleotide weights
###########################################################
for(j in seq_len(KMER_LENGTH))
{
pos <- j +
offset -
motif_start +
1
if(
pos < 1 ||
pos > pwm_length
)
{
stop(
"Calculated PWM position is outside motif boundaries."
)
}
occupied[pos] <- TRUE
counts[
chars[j],
pos
] <-
counts[
chars[j],
pos
] + w
}
###########################################################
## Add 25% pseudoweight at unoccupied positions
###########################################################
for(pos in which(!occupied))
{
counts[,pos] <-
counts[,pos] +
w * 0.25
missing_weight[pos] <-
missing_weight[pos] +
w
}
}
###############################################################
## Normalize PWM
##
## Convert weighted nucleotide counts
## into nucleotide probabilities
###############################################################
pwm <- sweep(
counts,
2,
colSums(counts),
"/"
)
###############################################################
## Trim edges if >75% missing weight
##
## Match Van Nostrand RBNS Figure 2A
## motif construction logic
###############################################################
missing_fraction <-
missing_weight /
total_weight
keep <-
missing_fraction <= 0.75
###############################################################
## Safety check
###############################################################
if(!any(keep))
{
stop(
"All PWM positions exceed the 75% missing-weight threshold."
)
}
first <- min(
which(keep)
)
last <- max(
which(keep)
)
pwm <- pwm[
,
first:last,
drop = FALSE
]
counts <- counts[
,
first:last,
drop = FALSE
]
###############################################################
## Add small pseudocount correction
##
## Prevent zero probabilities for information content
###############################################################
epsilon <- 1e-6
pwm <- pwm +
epsilon
pwm <- sweep(
pwm,
2,
colSums(pwm),
"/"
)
###############################################################
## Convert PWM for ggseqlogo
##
## ggseqlogo expects:
##
## rows = nucleotides
## columns = motif positions
###############################################################
rownames(pwm) <- alphabet
colnames(pwm) <- paste0(
"pos",
seq_len(
ncol(pwm)
)
)
###############################################################
## Save PWM
###############################################################
write.csv(
pwm,
paste0(
output_prefix,
"_IRIS_weighted_6mer_PWM.csv"
),
row.names = TRUE
)
###############################################################
## Generate sequence logo
###############################################################
pdf(
paste0(
output_prefix,
"_IRIS_Figure2A_6mer_logo.pdf"
),
width = 6,
height = 2.5
)
print(
ggseqlogo(
pwm,
method = "bits"
) +
ggtitle(
paste0(
output_prefix,
" IRIS Figure 2A 6-mer motif"
)
) +
theme_bw(
base_size = 14
)
)
dev.off()
###############################################################
## Final summary
###############################################################
cat(
"\n==============================\n"
)
cat(
"IRIS 6-mer motif logo generation complete\n"
)
cat(
"K-mer length: ",
KMER_LENGTH,
"\n",
sep = ""
)
cat(
"Reference k-mer: ",
reference,
"\n",
sep = ""
)
cat(
"Reference weight: ",
kmers$weight[ref_index],
"\n",
sep = ""
)
cat(
"Total input k-mers: ",
nrow(kmers),
"\n",
sep = ""
)
cat(
"Aligned k-mers: ",
nrow(aligned),
"\n",
sep = ""
)
cat(
"Rejected k-mers: ",
nrow(rejected),
"\n",
sep = ""
)
cat(
"Alignment rate: ",
round(
100 *
nrow(aligned) /
nrow(kmers),
2
),
"%\n",
sep = ""
)
cat(
"Final PWM length: ",
ncol(pwm),
"\n",
sep = ""
)
cat(
"\nOutput files:\n"
)
cat(
"- ",
output_prefix,
"_aligned_6mers.csv\n",
sep = ""
)
cat(
"- ",
output_prefix,
"_rejected_6mers.csv\n",
sep = ""
)
cat(
"- ",
output_prefix,
"_IRIS_weighted_6mer_PWM.csv\n",
sep = ""
)
cat(
"- ",
output_prefix,
"_IRIS_Figure2A_6mer_logo.pdf\n",
sep = ""
)
cat(
"==============================\n"
)
